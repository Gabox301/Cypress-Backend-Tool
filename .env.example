# Ejemplo — copia a .env y completa con tu Postgres (local, Neon, Supabase, RDS, etc.)
# Ver README.md → Variables de entorno y SSL
CYPRESS_DB_HOST=<tu-host>                  # ej: localhost  o  tu pooler/host
CYPRESS_DB_PORT=5432
CYPRESS_DB_NAME=<tu-db>                    # ej: test_db
CYPRESS_DB_USER=<tu-user>                  # ej: postgres
CYPRESS_DB_PASSWORD=<tu-password>
CYPRESS_DB_SSL=false                       # true si tu Postgres requiere SSL

# Fallback sin prefijo CYPRESS_DB_ (opcional)
# DB_HOST=localhost
# DB_PORT=5432
# DB_NAME=test_db
# DB_USER=postgres
# DB_PASSWORD=
# DB_SSL=false
