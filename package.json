{
  "name": "cypress-backend-tool",
  "version": "1.3.1",
  "description": "Cypress plugin for API testing and PostgreSQL queries with UI interface",
  "keywords": [
    "api",
    "cypress",
    "database",
    "http",
    "plugin",
    "postgresql",
    "testing",
    "ui"
  ],
  "license": "MIT",
  "author": "Gabriel Ortega <https://github.com/Gabox301>",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabox301/cypress-backend-tool.git"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "import": "./dist/tasks.js",
      "default": "./dist/tasks.js"
    },
    "./package.json": "./package.json"
  },
  "scripts": {
    "build": "npm run check && npm run lint && npm run unit && vp build",
    "check": "tsc --noEmit",
    "lint": "vp lint .",
    "test": "vp test run && cypress run",
    "unit": "vp test run",
    "watch": "vp test",
    "coverage": "vp test run --coverage",
    "ui": "cypress open",
    "prepare": "vp config"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "set-cookie-parser": "^3.2.1"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitest/coverage-v8": "5.0.5",
    "cypress": "^16.2.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.3",
    "svelte": "^5.57.2",
    "typescript": "^6.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plus": "1.4.0",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "cypress": ">=15.10.0"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.4.0",
    "vitest": "5.0.5"
  },
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": "12.2.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "24.22.1",
      "onFail": "download"
    }
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "cypress@16.2.0": true
  }
}
