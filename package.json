{
  "name": "cypress-backend-tool",
  "version": "1.2.3",
  "author": "Gabriel Ortega <https://github.com/Gabox301>",
  "description": "Cypress plugin for API testing and PostgreSQL queries with UI interface",
  "license": "MIT",
  "keywords": [
    "cypress",
    "plugin",
    "api",
    "http",
    "postgresql",
    "database",
    "testing",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabox301/cypress-backend-tool.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "import": "./dist/tasks.js",
      "default": "./dist/tasks.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run check && npm run lint && npm run unit && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && cypress run",
    "unit": "vitest run",
    "watch": "vitest",
    "coverage": "vitest run --coverage",
    "ui": "cypress open"
  },
  "dependencies": {
    "pg": "^8.23.1",
    "prismjs": "^1.30.0",
    "set-cookie-parser": "^3.1.3"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.6.4",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.3",
    "cypress": "^16.1.1",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.1",
    "globals": "^17.13.0",
    "jsdom": "^30.1.2",
    "svelte": "^5.57.2",
    "svelte-eslint-parser": "^1.9.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vite-plugin-dts": "^5.1.2",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "cypress": ">=15.10.0"
  },
  "engines": {
    "node": ">=22"
  },
  "allowScripts": {
    "cypress@16.1.1": true
  }
}
