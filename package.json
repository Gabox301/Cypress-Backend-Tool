{
  "name": "cypress-backend-tool",
  "version": "1.1.6",
  "author": "Gabriel Ortega <https://github.com/Gabox301>",
  "description": "Cypress plugin for API testing and PostgreSQL queries with UI interface",
  "license": "MIT",
  "keywords": [
    "cypress",
    "plugin",
    "api",
    "http",
    "postgresql",
    "database",
    "testing",
    "ui"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Gabox301/cypress-backend-tool.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./tasks": {
      "types": "./dist/tasks.d.ts",
      "import": "./dist/tasks.js",
      "default": "./dist/tasks.js"
    },
    "./package.json": "./package.json"
  },
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "npm run check && npm run lint && npm run unit && vite build",
    "check": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run && cypress run",
    "unit": "vitest run",
    "watch": "vitest",
    "coverage": "vitest run --coverage",
    "ui": "cypress open"
  },
  "dependencies": {
    "dotenv": "^17.4.2",
    "pg": "^8.23.0",
    "prismjs": "^1.30.0",
    "set-cookie-parser": "^3.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/svelte": "^5.4.2",
    "@testing-library/user-event": "^14.6.7",
    "@types/node": "^26.5.0",
    "@types/pg": "^8.23.1",
    "@vitest/coverage-v8": "^5.0.0",
    "cypress": "^16.0.0",
    "eslint": "^10.10.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.12.0",
    "jsdom": "^30.0.1",
    "svelte": "^5.57.0",
    "svelte-eslint-parser": "^1.8.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.69.0",
    "vite": "^8.2.2",
    "vite-plugin-dts": "^5.1.0",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "cypress": ">=15.10.0"
  },
  "engines": {
    "node": ">=22"
  }
}
